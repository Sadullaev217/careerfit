EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# The website, which has the privacy policy, terms and how the score works.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# RevenueCat public app key for store purchases. A Test Store key works only in development builds.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# The public demo: a short note on the login and Documents screens. Pair with DEMO_MODE on the API.
EXPO_PUBLIC_DEMO_MODE=false
