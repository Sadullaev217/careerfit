APP_NAME=CareerFit API
# staging or production make the API refuse to start with unsafe settings (https, Redis limits, no DEBUG).
ENVIRONMENT=development
DEBUG=true

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_server_only_secret_key

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Runs parsing inside the API process, for local development without Redis.
CELERY_TASK_ALWAYS_EAGER=false

OCR_LANGUAGES=eng+rus
# Optional: raises the GitHub API limit for reading public profiles.
GITHUB_TOKEN=

LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
OLLAMA_URL=http://localhost:11434
# Optional hosted model through OpenRouter (docs/ai-providers.md). Resume text then leaves this
# machine. Turn it on with LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
# Use Ollama when OpenRouter fails, for example after the free daily limit.
OLLAMA_FALLBACK=true

# Optional: only needed if push security is turned on for the Expo project.
EXPO_ACCESS_TOKEN=

# Stripe test-mode secret key (Developers > API keys). Products and prices: run scripts/stripe_setup.py.
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for /billing/stripe-webhook. Locally, `stripe listen` prints one.
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe's checkout and billing pages send people back to.
WEB_URL=http://localhost:3000

SENTRY_DSN=

# PostHog product analytics. Events carry counts and labels only, never resume text. Empty turns them off.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com

# Daily AI spending alerts in US dollars: for everyone together, and for any one account.
LLM_DAILY_BUDGET_USD=5
LLM_USER_DAILY_BUDGET_USD=0.5

# Exact web addresses allowed to call the API from a browser, as a JSON list. Never *.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Virus scanning of uploads: off or clamav (docker compose --profile scan up -d clamav). Deployed
# servers need clamav; uploads are refused while the scanner is down.
MALWARE_SCANNER=off
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Where request counts live. Deployed servers need Redis, e.g. redis://localhost:6379/2.
RATE_LIMIT_STORAGE=memory://

# RevenueCat secret API key, for checking phone purchases. Server only.
REVENUECAT_SECRET_KEY=
