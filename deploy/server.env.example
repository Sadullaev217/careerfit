# Copy to ~/careerfit/.env on the server and fill in. Never commit the filled-in file.
# Addresses and settings that are the same everywhere are set in compose.yml.

# The API's public name, pointing at the server's IP (docs/deployment.md, step 2)
API_DOMAIN=

# Supabase (the existing project)
SUPABASE_URL=https://lycbtrlbgouloozdcwuy.supabase.co
SUPABASE_SECRET_KEY=

# The web app on Vercel. ALLOWED_ORIGINS is a JSON list.
WEB_URL=https://careerfit-demo.vercel.app
ALLOWED_ORIGINS=["https://careerfit-demo.vercel.app"]

# AI on the server's two cores. A full analysis takes several minutes, so the limits are generous.
LLM_MODEL=qwen3.5:4b
LLM_TIMEOUT_SECONDS=900
AI_TASK_TIME_LIMIT_SECONDS=2400

# Optional
SENTRY_DSN=
POSTHOG_PROJECT_TOKEN=
LLM_DAILY_BUDGET_USD=0
LLM_USER_DAILY_BUDGET_USD=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVENUECAT_SECRET_KEY=
EXPO_ACCESS_TOKEN=
